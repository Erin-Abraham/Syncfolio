# Application Environment
ENVIRONMENT=development
APP_NAME=Syncfolio
APP_PORT=8000
DEBUG=True

# Database Configuration
POSTGRES_USER=syncfolio_user
POSTGRES_PASSWORD=syncfolio_dev_secret
POSTGRES_DB=syncfolio_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async Database URI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://syncfolio_user:syncfolio_dev_secret@postgres:5432/syncfolio_db