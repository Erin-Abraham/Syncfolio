# Application Environment
ENVIRONMENT=development
APP_NAME=Syncfolio
APP_PORT=8000
DEBUG=True

# Database Configuration
# IMPORTANT: replace CHANGE_ME_STRONG_PASSWORD with a long random value in your real .env
# (generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))")
POSTGRES_USER=syncfolio_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=syncfolio_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async Database URI (asyncpg driver) - keep the password in sync with POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://syncfolio_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/syncfolio_db

# Redis Cache & Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0